# Copy this to .env and fill in your values
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure Speech Service
SPEECH_ENDPOINT=https://westus2.api.cognitive.microsoft.com/
SPEECH_SUBSCRIPTION_KEY=<your-speech-subscription-key>
API_VERSION=2024-04-15-preview

# Azure Cosmos DB (MongoDB vCore)
AZCOSMOS_CONNSTR=mongodb+srv://<user>:<password>@<host>/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
AZCOSMOS_DATABASE_NAME=customerservice
AZCOSMOS_CONTAINER_NAME=cases
AZCOSMOS_DATABASE_NAME_Batch=avatarbatch
AZCOSMOS_CONTAINER_NAME_batch=avatarbatch

# Azure Blob Storage
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
BLOB_CONTAINER_NAME=uservideos1

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_KEY=<your-search-api-key>
AZURE_SEARCH_INDEX=case3rag

# Avatar Background Images
BACKGROUND_IMAGE_Binaka_URL=https://<storage>.blob.core.windows.net/<container>/avatar-bg.png
BACKGROUND_IMAGE_sri_URL=https://<storage>.blob.core.windows.net/<container>/avatar-bg.png
BACKGROUND_IMAGE_mike_URL=https://<storage>.blob.core.windows.net/<container>/avatar-bg.png

# Azure Communication Services
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
EMAIL_SENDER_ADDRESS=DoNotReply@<domain>.azurecomm.net

# GitHub Integration
GITHUB_TOKEN=<your-github-personal-access-token>
GITHUB_OWNER=<github-username>
GITHUB_REPO=<repository-name>
